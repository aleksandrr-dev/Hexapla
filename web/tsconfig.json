{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": ["vite/client"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["src/route.test.ts", "src/parallel.test.ts", "src/prefs.test.ts", "src/audio.test.ts", "src/search.test.ts", "src/marks.test.ts", "src/xrefs.test.ts", "src/strongs.test.ts", "src/webster.test.ts", "src/offline.test.ts", "src/install.test.ts", "src/locale.test.ts", "src/plans.test.ts", "src/speech.test.ts"]
}
